{
  "name": "@7n/rules-lang-rust",
  "version": "0.14.1",
  "description": "Плагін @7n/rules: Rust/Cargo-екосистема — taze-провайдер (Cargo.toml, cargo-edit)",
  "keywords": [
    "rust",
    "cargo",
    "taze",
    "n-rules-plugin"
  ],
  "homepage": "https://github.com/nitra/7n-rules#readme",
  "bugs": {
    "url": "https://github.com/nitra/7n-rules/issues"
  },
  "license": "ISC",
  "author": "v@nitra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitra/7n-rules.git",
    "directory": "plugins/lang-rust"
  },
  "type": "module",
  "files": [
    "coverage-provider",
    "rules",
    "doc-files",
    "taze",
    "skills",
    "CHANGELOG.md",
    "!**/*.test.mjs",
    "!**/*_test.rego",
    "!**/fixtures/**",
    "!**/tests/**"
  ],
  "n-rules": {
    "requiresPluginApi": 2,
    "capabilities": [
      "lang:rust"
    ],
    "slots": {
      "provides": [
        { "slot": "rules.directory", "version": 1, "id": "rust-rules", "resource": "./rules" },
        { "slot": "taze.provider", "version": 1, "id": "taze-rust", "resource": "./taze/provider.mjs" },
        { "slot": "coverage.provider", "version": 1, "id": "coverage-rust", "resource": "./coverage-provider/provider.mjs" },
        { "slot": "doc-files.extractor", "version": 1, "id": "doc-files-rust", "resource": "./doc-files/extractors.mjs" },
        {
          "slot": "doc-files.extensions",
          "version": 1,
          "id": "doc-files-ext-rust",
          "value": { ".rs": "Rust Module" }
        },
        { "slot": "skills.fragment", "version": 1, "id": "taze", "resource": "./skills/taze/SKILL.fragment.md" }
      ]
    }
  },
  "dependencies": {
    "globby": "^16.0.0",
    "smol-toml": "^1.7.0"
  },
  "peerDependencies": {
    "@7n/rules": ">=1.52.0",
    "@7n/llm-lib": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "peerDependenciesMeta": {
    "@7n/llm-lib": {
      "optional": true
    }
  }
}
