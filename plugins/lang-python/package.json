{
  "name": "@7n/rules-lang-python",
  "version": "0.10.1",
  "description": "Плагін @7n/rules: Python/uv-екосистема — taze-провайдер (pyproject.toml, PEP 508/PEP 440)",
  "keywords": [
    "python",
    "uv",
    "taze",
    "n-rules-plugin"
  ],
  "homepage": "https://github.com/nitra/7n-rules#readme",
  "bugs": {
    "url": "https://github.com/nitra/7n-rules/issues"
  },
  "license": "ISC",
  "author": "v@nitra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitra/7n-rules.git",
    "directory": "plugins/lang-python"
  },
  "type": "module",
  "files": [
    "coverage-provider",
    "doc-files",
    "rules",
    "taze",
    "skills",
    "CHANGELOG.md",
    "!**/*.test.mjs",
    "!**/*_test.rego",
    "!**/fixtures/**",
    "!**/tests/**"
  ],
  "n-rules": {
    "requiresPluginApi": 2,
    "capabilities": [
      "lang:python"
    ],
    "slots": {
      "provides": [
        { "slot": "rules.directory", "version": 1, "id": "python-rules", "resource": "./rules" },
        { "slot": "taze.provider", "version": 1, "id": "taze-python", "resource": "./taze/provider.mjs" },
        { "slot": "coverage.provider", "version": 1, "id": "coverage-python", "resource": "./coverage-provider/provider.mjs" },
        { "slot": "doc-files.extractor", "version": 1, "id": "doc-files-python", "resource": "./doc-files/extractors.mjs" },
        {
          "slot": "doc-files.extensions",
          "version": 1,
          "id": "doc-files-ext-python",
          "value": { ".py": "Python Module" }
        },
        { "slot": "skills.fragment", "version": 1, "id": "taze", "resource": "./skills/taze/SKILL.fragment.md" }
      ]
    }
  },
  "dependencies": {
    "globby": "^16.0.0",
    "smol-toml": "^1.7.0"
  },
  "peerDependencies": {
    "@7n/rules": ">=1.13.0",
    "@7n/llm-lib": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "peerDependenciesMeta": {
    "@7n/llm-lib": {
      "optional": true
    }
  }
}
