{
  "name": "@7n/rules-lang-php",
  "version": "0.5.0",
  "description": "Плагін @7n/rules: PHP/Composer-екосистема — lint (PHPCS Security, PHP-CS-Fixer, PHPStan, Psalm, composer audit) + CI-артефакти GitHub/Azure + taze-провайдер (composer.json)",
  "keywords": [
    "php",
    "composer",
    "lint",
    "taze",
    "n-rules-plugin"
  ],
  "homepage": "https://github.com/nitra/7n-rules#readme",
  "bugs": {
    "url": "https://github.com/nitra/7n-rules/issues"
  },
  "license": "ISC",
  "author": "v@nitra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitra/7n-rules.git",
    "directory": "plugins/lang-php"
  },
  "type": "module",
  "files": [
    "rules",
    "slots",
    "skills",
    "taze",
    "CHANGELOG.md",
    "doc-files",
    "coverage-provider",
    "knowledge",
    "!**/*.test.mjs",
    "!**/*_test.rego",
    "!**/fixtures/**",
    "!**/tests/**"
  ],
  "n-rules": {
    "requiresPluginApi": 2,
    "capabilities": [
      "lang:php"
    ],
    "slots": {
      "provides": [
        {
          "slot": "rules.directory",
          "version": 1,
          "id": "php-rules",
          "resource": "./rules"
        },
        {
          "slot": "ci.artifact",
          "version": 1,
          "id": "php-github-lint",
          "resource": "./slots/ci/php-github-lint.json",
          "requires": {
            "capabilities": [
              "ci:github"
            ]
          }
        },
        {
          "slot": "ci.artifact",
          "version": 1,
          "id": "php-azure-lint",
          "resource": "./slots/ci/php-azure-lint.json",
          "requires": {
            "capabilities": [
              "ci:azure"
            ]
          }
        },
        {
          "slot": "ci.artifact",
          "version": 1,
          "id": "php-lint-text-patch",
          "resource": "./slots/ci/php-lint-text-patch.json",
          "requires": {
            "capabilities": [
              "ci:github"
            ]
          }
        },
        {
          "slot": "taze.provider",
          "version": 1,
          "id": "taze-php",
          "resource": "./taze/provider.mjs"
        },
        {
          "slot": "skills.fragment",
          "version": 1,
          "id": "taze",
          "resource": "./skills/taze/SKILL.fragment.md"
        },
        {
          "slot": "doc-files.extractor",
          "version": 1,
          "id": "doc-files-php",
          "resource": "./doc-files/extractors.mjs"
        },
        {
          "slot": "doc-files.extensions",
          "version": 1,
          "id": "doc-files-ext-php",
          "value": {
            ".php": "PHP Module"
          }
        },
        {
          "slot": "knowledge.extractor",
          "version": 1,
          "id": "knowledge-php",
          "resource": "./knowledge/extractor.mjs"
        },
        {
          "slot": "coverage.provider",
          "version": 1,
          "id": "coverage-php",
          "resource": "./coverage-provider/provider.mjs"
        }
      ]
    }
  },
  "peerDependencies": {
    "@7n/rules": ">=1.52.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  },
  "dependencies": {
    "php-parser": "^3.7.0"
  }
}
