package n-rules:caps@1.0.0;

// Той самий пакет `n-rules:caps@1.0.0`, що `tool-runner.wit`/`file-reader.wit`/
// `llm-consumer.wit` (доккомент пакета живе там — `file-reader.wit` пояснює
// чому `package` тут навмисно без коментаря перед ним: wit-parser вимагає
// doc-коментар пакета лише в ОДНОМУ файлі багатофайлового пакета).
//
// `registry-reader` закриває S1 карти `docs/specs/2026-08-30-contract-
// roadmap-blocked-concerns.md` §2.2/§2.3/§3 — клас «хост знає, гість не має
// права знати»: `azure-pipelines/service_deploy_pipeline` питає про реєстр
// увімкнених lint-правил (граф підключених плагінів + `.n-rules.json`),
// `ci_artifact/consume` — про слот-граф `ci.artifact@1` ІНШИХ плагінів і їхні
// canonical-шаблони. Обидва питання — про дані, які пісочниця гостя ЗА
// ЗАДУМОМ не показує (склад графа плагінів консюмера, чужі пакети), а не про
// брак каналу для переданого вмісту.
//
// # Чому ДВА вузькі імпорти, а не один `variant`-запит
//
// §2.83 (`docs/plans/2026-08-05-open-questions-register.md`) зміряла:
// додати case до `variant` неможливо мінором (`expected variant of N cases,
// found N-1 cases` — Component Model звіряє арність, не «розширюваність»).
// Один import `registry-query(variant) -> variant` виглядав би дешевшим
// сьогодні, але перший же ТРЕТІЙ запит до реєстру перетворив би дешеву
// адитивну еволюцію на мажор. Два вузькі імпорти додаються по одному, кожен
// мінором, назавжди — те саме рішення, що вже ухвалене для `run-tool` →
// `exec-tool` (`world.wit`, новий import замість розширення сигнатури
// наявного) і для пари `list-files`/`read-file-bytes` у `file-reader.wit`
// поруч.
//
// # Чому ОДИН world із двома імпортами, а не два world-и
//
// Обидва запити належать тому самому класу повноважень (розділ 4 спеки
// `docs/specs/2026-08-31-plugin-contract-v5.md`, критерій 1: доступ до
// ресурсу поза межами переданих даних — тут: граф підключених плагінів і
// чужі пакети) — той самий принцип, що вже звів `list-files`+`read-file-bytes`
// в один `file-reader`, а `run-tool`+`exec-tool` в один `tool-runner`.
//
// # `option`, а не `result` — навмисно
//
// На відміну від `file-reader`/`llm-consumer` (де `result<T, domain-error>`
// розрізняє «хост не підтримує» від «сталася помилка виконання»), тут немає
// проміжного «виконання» — питання або має відповідь (хост тримає реєстр),
// або ні (виклик поза оркестрацією, що його резолвить). Те саме рішення,
// що вже прийняте для `host-context` (`world.wit`, slot-канал): невідомий
// стан → `none`, skip-not-crash, гість деградує сам, не панікує.
//
// `none` — хост НЕ МАЄ реєстру (виклик поза оркестрацією, що його
// резолвить); `some([])` — реєстр Є й каже «нічого не тригериться»/
// «жодної contribution». Розрізняти обов'язково: злиття цих двох станів у
// порожній список — рівно той тихий скіп класу §2.65 реєстру відкритих
// питань, від якого гість деградував би мовчки замість чесно віддати
// порожній результат і пустити наявний (не-wasm) канон.
world registry-reader {
  use n-rules:slots/ci-artifact@1.0.0.{descriptor as ci-artifact-descriptor};

  /// Одна вже зарезолвлена `ci.artifact@1`-contribution: дескриптор ЧУЖОГО
  /// плагіна плюс ПРОЧИТАНИЙ хостом canonical-шаблон. Гість не бачить ні
  /// графа плагінів, ні чужих пакетів — лише результат.
  record resolved-ci-artifact {
    descriptor: ci-artifact-descriptor,
    /// Вміст canonical-шаблону, прочитаний хостом із пакета, що зробив
    /// contribution. Текст (шаблони — yml/json); не-UTF-8 шаблон хост
    /// відхиляє гучно, тим самим правилом, що `read_source_files`
    /// (§2.83 реєстру) — байтових шаблонів у слоті не буває за побудовою:
    /// contribution із нечитабельним шаблоном випадає з результату РАЗОМ із
    /// причиною в логах хоста (`log`), не тихо.
    template-content: string,
    /// Provenance для повідомлень гостя (id плагіна + шлях шаблону).
    provenance: string,
  }

  /// Активні lint-домени для піддерева `path` (repo-relative) — host-mediated
  /// відповідь на питання, яке гість не може поставити самостійно: склад
  /// графа плагінів консюмера й `.n-rules.json` живуть поза його пісочницею.
  /// Порядок — locale-sorted rule-id, той самий, що `n-rules ci plan`.
  import active-domains: func(path: string) -> option<list<string>>;

  /// Резолв графа `ci.artifact@1` для заданої consumer-capability. Колізії
  /// `artifact-id` (два contributions різних плагінів заявляють той самий
  /// артефакт) — ПОМИЛКА ХОСТА до цього виклику (дзеркало JS
  /// `splitCiArtifactCollisions`): гість отримує вже колізійно-чистий
  /// список — вирішувати конфлікт між contributions двох незнайомих йому
  /// плагінів лишається роботою оркестратора, не одного зі споживачів
  /// слоту.
  import resolve-ci-artifacts: func(target-capability: string) -> option<list<resolved-ci-artifact>>;
}
