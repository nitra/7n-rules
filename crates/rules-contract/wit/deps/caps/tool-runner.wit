// Пакет `n-rules:caps@1.0.0` — світи повноважень (спека
// `docs/specs/2026-08-31-plugin-contract-v5.md`, розділ 6): гість, що не
// оголосив конкретний world цього пакета, не має відповідних host-import-ів
// у своєму типі — заборона тримається на структурній типізації WIT, а не на
// звірці `plugin.toml` хостом. §2.1 спеки заміряла (2026-08-31), що чинний
// декларативний гейт (`capabilities.fs-read`/`network`) порожній скрізь —
// усі шість гостей несуть `fs_read = []`, `network = false` — тобто нічого
// реального не звіряє; світ повноважень робить те саме питання типовим,
// не декларативним.
//
// Три файли в цій теці — один пакет, один цикл версіонування (розділ 12
// спеки, відкрите питання «версіонування світів повноважень»: `caps@1.0.0`
// як один пакет — обраний варіант ЗАРАЗ, бо дешевший; розщеплення на
// пакет-на-world лишається можливим пізніше без зміни цього рішення).
//
// Один клас повноважень = один world (розділ 4 спеки, критерій 1: доступ
// до ресурсу поза межами переданих даних). `tool-runner` — спавн
// зовнішнього процесу; `run-tool`/`exec-tool` навмисно ОДИН world, не два
// (розділ 4 спеки): обидва належать тому самому класу «гість просить, хост
// спавнить», `exec-tool` лише додає виконавчий контекст (cwd/env/scratch-
// обмін) до того самого повноваження.
//
// # Дублювання форми з `wit/world.wit` — свідоме, тимчасове
//
// Типи нижче (`tool-output`, `scratch-file`, `tool-request`, `tool-result`)
// структурно ІДЕНТИЧНІ однойменним типам у `wit/world.wit`, де
// `run-tool`/`exec-tool` живуть СЬОГОДНІ. Цей крок (порядок реалізації,
// п.1 спеки) лише заводить пакет `caps` ПОРУЧ із ядром — сам ядровий world
// не змінюється (це порушило б бюджет паралельної хвилі, що зараз чіпає
// `world.wit`). Крок 3 спеки («хост: лінкер під оголошені світи») перенесе
// самі імпорти `run-tool`/`exec-tool` сюди назавжди й прибере копію з
// ядра — до того моменту наявність двох копій тієї самої форми в двох
// world-ах є задокументованим, а не випадковим станом.
package n-rules:caps@1.0.0;

world tool-runner {
  /// Результат `run-tool` — код завершення (`none`, якщо процес не
  /// стартував) і захоплені потоки. Дзеркало `world.wit::tool-output`.
  record tool-output {
    status: option<s32>,
    stdout: string,
    stderr: string,
  }

  /// Один файл scratch-обміну `exec-tool`: `path` — ВІДНОСНИЙ до
  /// scratch-каталогу виклику, НЕ до кореня репо. Дзеркало
  /// `world.wit::scratch-file`.
  record scratch-file {
    path: string,
    content: string,
  }

  /// Запит `exec-tool` — надмножина параметрів `run-tool` плюс виконавчий
  /// контекст. Дзеркало `world.wit::tool-request`.
  record tool-request {
    /// Ім'я тула — ДОСЛІВНО те, що в `manifest.tools`.
    tool: string,
    args: list<string>,
    stdin: option<string>,
    /// Робочий каталог процесу, posix-relative від кореня репо; `none` —
    /// сам корінь.
    cwd: option<string>,
    /// Змінні середовища, накладені ПОВЕРХ успадкованого env хоста.
    env: list<tuple<string, string>>,
    /// Файли, які хост матеріалізує у scratch-каталозі ПЕРЕД спавном.
    scratch-in: list<scratch-file>,
    /// Glob-и файлів, які хост зчитує зі scratch-каталогу ПІСЛЯ виходу
    /// процесу.
    scratch-out: list<string>,
  }

  /// Результат `exec-tool` — `tool-output` плюс зібрані scratch-файли.
  /// Дзеркало `world.wit::tool-result`; той самий доккомент про межу
  /// довіри (спавнений тул виконується з правами хоста, поза
  /// wasm-пісочницею) лишається на боці `world.wit` — тут форма без
  /// повтору прози.
  record tool-result {
    status: option<s32>,
    stdout: string,
    stderr: string,
    scratch-out: list<scratch-file>,
  }

  /// Host-mediated spawn зовнішнього tool-у (рішення Д контракту v3) —
  /// плагін сам нічого не спавнить, лише запитує виконання задекларованого
  /// в `manifest.tools` tool-у.
  import run-tool: func(tool: string, args: list<string>, stdin: option<string>) -> tool-output;

  /// Host-mediated spawn з виконавчим контекстом (зріз 5 контракту v3.1) —
  /// `run-tool` плюс cwd/env/двобічний scratch-обмін файлами.
  import exec-tool: func(request: tool-request) -> tool-result;
}
