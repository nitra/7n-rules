package n-rules:caps@1.0.0;

// Той самий пакет `n-rules:caps@1.0.0`, що `tool-runner.wit` (доккомент
// пакета живе там — див. `file-reader.wit` про чому `package` тут навмисно
// без коментаря перед ним).
//
// `llm-consumer` (§6.3 спеки `docs/specs/2026-08-31-plugin-contract-v5.md`):
// виклик робить ХОСТ — ключі не покидають хост, гість не бачить
// креденшелів. Прецедент — `run-tool` (`tool-runner` поруч): гість просить,
// хост вирішує й виконує.
//
// # Форма `llm-request`/`llm-response` — навмисно відкрита
//
// Спека називає це прямим відкритим питанням (розділ «Відкриті питання»):
// синхронний виклик чи стрімінг, як передається вибір моделі —
// проєктується разом із портом `docgen` (крок 7 порядку реалізації), коли
// буде видно реальні потреби LLM-стадій (`crates/rules-docs/src/lib.rs`
// називає чотири стадії під одним `wave::ChainRef`: candidate/claims/
// entailment/gap-mappings). Тут — мінімальна чесна форма без вигаданих
// полів: текстовий запит на вхід, текстова відповідь на вихід. Немає
// підстави зараз додавати `model`/`temperature`/`stream` — жоден наявний
// споживач цього репозиторію їх не показав; додавання полів пізніше —
// additive в межах `1.x`, доки не міняє форму наявних.
world llm-consumer {
  /// Помилка домен-функції цього world-а. Форма ідентична
  /// `world.wit::domain-error` (див. доккомент вибору не-`use` у
  /// `file-reader.wit`).
  variant domain-error {
    not-supported,
    failed(string),
  }

  /// Запит LLM-виклику. Єдине поле, на яке є підстава ЗАРАЗ.
  record llm-request {
    prompt: string,
  }

  /// Відповідь LLM-виклику. Той самий принцип мінімальності.
  record llm-response {
    text: string,
  }

  import llm-call: func(request: llm-request) -> result<llm-response, domain-error>;
}
