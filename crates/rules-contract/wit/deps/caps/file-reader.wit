package n-rules:caps@1.0.0;

// Той самий пакет `n-rules:caps@1.0.0`, що `tool-runner.wit` — доккомент
// пакета живе РІВНО там (wit-parser вимагає doc-коментар пакета лише в
// одному файлі багатофайлового пакета; тут `package` навмисно без
// коментаря перед ним, інакше `wasm-tools component wit` бачить ДРУГИЙ
// doc-коментар на тому самому пакеті й відхиляє директорію).
//
// `file-reader` — рішення 2 спеки (§6.2, `docs/specs/2026-08-31-plugin-
// contract-v5.md`). Знімає обидві причини, з яких §2.83/§2.92 тримали
// `bun/package_json` непортовним: тип межі (`list<u8>` замість `string` —
// бінарні файли перестають ламатись, зникає клас вад `from_utf8_lossy`) і
// обсяг (гість читає вибірково через `list-files`, а не дістає повний
// вміст при вибірковій потребі).
//
// Два імпорти РАЗОМ, не окремими world-ами: `list-files` дає перелік БЕЗ
// вмісту — гість дізнається обсяг перед тим, як платити за читання;
// `read-file-bytes` — вміст ОДНОГО файлу. Обидва належать тому самому
// класу повноважень (доступ до диска поза межами переданих даних, розділ
// 4 спеки, критерій 1), тож не два world-и, а один із двома функціями —
// той самий принцип, що звів `run-tool`+`exec-tool` в один `tool-runner`.
world file-reader {
  /// Помилка домен-функції цього world-а. Форма ідентична
  /// `world.wit::domain-error` (`not-supported`/`failed(string)`). Не
  /// `use` з ядра: `domain-error` там оголошений у тілі world `plugin`
  /// напряму, не в окремому інтерфейсі, — імпортувати нема звідки без
  /// зміни `world.wit`, забороненої в цьому кроці (див. доккомент пакета
  /// в `tool-runner.wit` про тимчасове дублювання форми).
  variant domain-error {
    not-supported,
    failed(string),
  }

  /// Перелік шляхів за глобами, БЕЗ вмісту — дає гостю дізнатись обсяг
  /// перед тим, як платити за читання. Хост відповідає за скоуп:
  /// не виходить за корінь репо й поважає `.n-rules.json:ignore` (той
  /// самий обхід, що `build_full_scope_files`, JS-бік).
  /// `result`, а не голий `list<string>`: без каналу помилки збій обходу
  /// (незвʼязаний корінь, побитий glob, помилка читання дерева) не
  /// відрізнити від «нічого не знайшлось» — мовчазний пропуск, який цей
  /// проєкт трактує як ваду. Форму виправлено ДО того, як світ почали
  /// оголошувати гості: тоді це коштувало б зміни контракту.
  import list-files: func(globs: list<string>) -> result<list<string>, domain-error>;

  /// Вміст одного файлу БАЙТАМИ. `list<u8>`, не `string`: бінарні файли
  /// перестають ламатись, і зникає клас вад `from_utf8_lossy` (§2.83).
  import read-file-bytes: func(path: string) -> result<list<u8>, domain-error>;
}
